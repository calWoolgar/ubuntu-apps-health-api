[Unit]
Description=Deploy successful main builds of Ubuntu Apps Health API
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=devadmin
WorkingDirectory=/home/devadmin/apps/ubuntu-apps-health-api
Environment=DEPLOY_ROOT=/home/devadmin/apps/ubuntu-apps-health-api
Environment=DEPLOY_HEALTH_URL=http://192.168.1.87:8080/health
ExecStart=/usr/bin/python3 /home/devadmin/apps/ubuntu-apps-health-api/deployer/PollDeploy.py
TimeoutStartSec=15min
TimeoutStopSec=3min
